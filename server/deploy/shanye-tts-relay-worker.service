[Unit]
Description=Shanye TTS relay polling worker
After=network-online.target shanye-tts-api.service shanye-tts-gpu.service shanye-tts-cpu.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jetson/workspace/shanye-tts-service/app
EnvironmentFile=/home/jetson/workspace/shanye-tts-service/service.env
ExecStart=/home/jetson/workspace/shanye-tts-service/.api-venv/bin/python -m server.remote_worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=infinity
UMask=0077

[Install]
WantedBy=default.target
