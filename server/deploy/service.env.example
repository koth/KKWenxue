SHANYE_STATE=/home/jetson/.local/share/shanye-tts
SHANYE_AUDIO=/home/jetson/workspace/shanye-tts-service/audio
SHANYE_ZONOS_ROOT=/home/jetson/workspace/zonos3-mini
SHANYE_ZONOS_PORT=17868
SHANYE_ZONOS_TIMEOUT=180
SHANYE_SPEECH_VERIFY=1
SHANYE_SPEECH_VERIFY_PYTHON=/home/jetson/workspace/shanye-tts-service/.qa-venv/bin/python
SHANYE_SPEECH_VERIFY_MODEL=/home/jetson/workspace/sensevoice-int8-20240717
PATH=/home/jetson/workspace/shanye-tts-service/.api-venv/bin:/usr/local/bin:/usr/bin:/bin
HF_HOME=/home/jetson/.cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
MODELSCOPE_CACHE=/home/jetson/workspace/CosyVoice/.modelscope-cache
OPENBLAS_NUM_THREADS=2
OMP_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
PYTHONUNBUFFERED=1

# Optional generic Rust task relay adapter. Leave SHANYE_RELAY_URL empty to
# disable polling on this GPU host.
SHANYE_RELAY_URL=
SHANYE_RELAY_TOKEN=
SHANYE_RELAY_WORKER_ID=
SHANYE_RELAY_POLL_SECONDS=5
SHANYE_RELAY_LEASE_SECONDS=300
SHANYE_RELAY_HEARTBEAT_SECONDS=15
SHANYE_RELAY_REQUEST_TIMEOUT=30
# Stable worker id is required so the same machine can resume deferred transfers.
SHANYE_RELAY_DIRECT_URL=http://192.168.3.33:17871
SHANYE_RELAY_DIRECT_HOST=0.0.0.0
SHANYE_RELAY_DIRECT_PORT=17871
