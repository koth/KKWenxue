SHANYE_RELAY_BIND=127.0.0.1:17870
SHANYE_RELAY_TOKEN=replace-with-a-long-private-token
SHANYE_RELAY_DATABASE=/var/lib/shanye-task-relay/relay.sqlite
SHANYE_RELAY_TEMP_DIR=/var/lib/shanye-task-relay/tmp
SHANYE_RELAY_MAX_RESULT_BYTES=8589934592
SHANYE_RELAY_RESULT_TTL_SECS=86400
SHANYE_RELAY_CLEANUP_SECS=300
