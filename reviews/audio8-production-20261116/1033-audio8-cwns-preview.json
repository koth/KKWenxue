{"artifact_id":"8abb26c6b20a4c15a47dd6eacbedb700","audio_file":"chapter.m4a","audio_sha256":"d9b957ae525724a75606cb9b66ff2d8cc5a5facfa37dfe09b86344be5cf82c9b","book_id":"local-f6a38e5f6131290460a62005","chapter_id":"local-f6a38e5f6131290460a62005-1031","chapter_index":1031,"chapter_number":1033,"complete":false,"cues":[{"audio_id":"095eaa55d7dd4d54b655e770c383de7c","end_ms":20991,"end_utf16":98,"original_text":"　　因為下雨的緣故，腳下的路泥濘坎坷，跑在最前面的清水蒼介跌倒了兩次，但又很快爬起來，咬著牙繼續跑，這孩子鬼比他所想的更加難纏，死咬著他們不放，令他心驚的是，即便他們衝到了山腳下，孩子鬼依舊在追。","segment_id":"43f6cb5e2af899a8aa03a934c6d6f0c6134c17039b80ca33e4683f99df67f192","sentence_end_utf16":98,"sentence_index":0,"sentence_start_utf16":0,"spoken_text":"因为下雨的缘故，脚下的路泥泞坎坷，跑在最前面的清水苍介跌倒了两次，但又很快爬起来，咬著牙继续跑，这孩子鬼比他所想的更加难缠，死咬著他们不放，令他心惊的是，即便他们冲到了山脚下，孩子鬼依旧在追。","start_ms":0,"start_utf16":0},{"audio_id":"f2891a3dae5a4990a259449fbc9718dd","end_ms":25536,"end_utf16":118,"original_text":"\n\n　　「清水組長，它..它還在後面！」","segment_id":"ef0febd220c0822f1aeae75458cd504d07db935dd17cac446787b17d6ff5d211","sentence_end_utf16":118,"sentence_index":1,"sentence_start_utf16":98,"spoken_text":"「清水组长，它..它还在后面！」","start_ms":21171,"start_utf16":98},{"audio_id":"5abc17a05e9a4414902e8320aae4e6a8","end_ms":32496,"end_utf16":147,"original_text":"此刻的黑澤凜算是有苦說不出，他明明可以跑在清水蒼介前面的。","segment_id":"45ab62ea93a4de85e2f59ffd34a19dbfaa224897991460ccfe7cc4c18dd9f22a","sentence_end_utf16":147,"sentence_index":2,"sentence_start_utf16":118,"spoken_text":"此刻的黑泽凛算是有苦说不出，他明明可以跑在清水苍介前面的。","start_ms":25716,"start_utf16":118},{"audio_id":"f684878632a547e78e40a695fc1c7afb","end_ms":42708,"end_utf16":191,"original_text":"如今的黑澤凜身上浮現出了十幾道傷痕，這還不包括被圓規刺屁股，雨水接觸到傷口疼的他直哆嗦。","segment_id":"0a18530b593b7e91fe31aeb92f116b4fe5ed94e0b6fd18b8e28d5c5aa98c84ab","sentence_end_utf16":191,"sentence_index":3,"sentence_start_utf16":147,"spoken_text":"如今的黑泽凛身上浮现出了十几道伤痕，这还不包括被圆规刺屁股，雨水接触到伤口疼的他直哆嗦。","start_ms":32676,"start_utf16":147}],"duration_ms":42708,"encoder_tolerance_ms":150,"export":{"format":"m4a","normalize_loudness":true,"pause_ms":180,"speed":1.0},"loudness":{"codec_peak_correction_db":0.0,"input_lufs":-21.83,"input_true_peak_db":-6.75,"mode":"two-pass-loudnorm","output_lufs":-18.03,"output_true_peak_db":-3.02,"target_lufs":-18.0,"true_peak_limit_db":-2.0,"version":"ebu-r128-two-pass-v1"},"offsets":"UTF-16 into Android Chapter.text","profile":{"dtype":"bfloat16","engine":"audio8-realistic-air-cpp","inference_mode":"reference-codes","language":"Chinese","model":"Edge0/Audio8-TTS-Realistic-Air","normalization":"reader-canonical+OpenCC-t2s-v1","ref_audio_path":"reference-voices/a63c22269e594284805a0ffaadb784a1.normalized.wav","ref_audio_sha256":"2a1d613e30084ce5b137d8a3ad823f402e6cc54493841765666102bf50d8cd8d","ref_text":"历史长河中，无数先贤用智慧和勇气书写了辉煌篇章。今天，我们回顾那些经典时刻，从中汲取力量，照亮前行的道路，共同探索未知的未来。","revision":"6bf7a980759d8022a66922ee975dab99229a2dd9","seed":42,"segmentation":"reader-sentence-bounded160-v1","speaker":"clone:a63c22269e594284805a0ffaadb784a1","style_source":"reference-audio","temperature":0.7,"text_frontend":false,"top_k":50,"top_p":0.9,"voice_clone_ref_id":"a63c22269e594284805a0ffaadb784a1"},"sample_rate":24000,"schema_version":2,"skipped_segments":[],"source_revision":"e5c3227fe1c3eaa9cf3831bcb28fa79513f32214589ea2e930bf8bf08278dc86","source_sha256":"e052be6ad01aed6f062c0b0304728b7c6f33a56d520865b531d4eaeeb7f3c70d","speed":1.0,"title":"第1033章 天選之子","variant_id":"ff95bba51c8cd226c10d7d563a3361ec0bb2f9fe8075faf4c0f2a146654aacf7"}